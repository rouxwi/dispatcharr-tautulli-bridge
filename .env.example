# Address of your Dispatcharr server, as seen from this container
DISPATCHARR_URL=http://192.168.1.10:9191
# API key of a Dispatcharr ADMIN user (Dispatcharr: Settings > Users > your admin user > API key)
DISPATCHARR_API_KEY=paste-your-dispatcharr-api-key-here
# 32-character token the Tautulli Remote app will use to log in. Generate one with: openssl rand -hex 16
DEVICE_TOKEN=0123456789abcdef0123456789abcdef
# Name shown for this server in the Tautulli Remote app
SERVER_NAME=Dispatcharr
